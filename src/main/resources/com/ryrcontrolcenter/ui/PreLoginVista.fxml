<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="raiz" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ryrcontrolcenter.controller.PreLoginController">

    <Region style="-fx-background-color: rgba(8, 26, 78, 0.68);" />

    <VBox alignment="CENTER" spacing="4">
        <padding><Insets bottom="14" left="24" right="24" top="10" /></padding>

        <HBox alignment="CENTER" spacing="2">
            <Label style="-fx-text-fill: white; -fx-font-size: 62px; -fx-font-weight: bold;" text="R" />
            <Label style="-fx-text-fill: #2f6bff; -fx-font-size: 62px; -fx-font-weight: bold;" text="&amp;" />
            <Label style="-fx-text-fill: white; -fx-font-size: 62px; -fx-font-weight: bold;" text="R" />
        </HBox>

        <Label style="-fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 15px;" text="Global Technical" />
        <Label style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;" text="Services S.A.S." />

        <Pane fx:id="globo" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="190.0" prefWidth="337.0" />

        <HBox alignment="CENTER" spacing="12">
            <StackPane fx:id="spinnerBox" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="40.0" prefWidth="40.0" />
            <Label fx:id="lblEstado" style="-fx-text-fill: white; -fx-font-size: 21px; -fx-font-weight: bold;" text="Iniciando R&amp;R ControlCenter..." />
        </HBox>
        
        <Label fx:id="lblDetalle" style="-fx-text-fill: rgba(255,255,255,0.80); -fx-font-size: 13px;" text="Cargando base de datos local SQLite..." />

        <Button fx:id="btnReintentar" onAction="#onReintentarClick" style="-fx-background-color: #d1453b; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Reintentar" visible="false" managed="false" />
    </VBox>
</StackPane>
