<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="420.0" spacing="12" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ryrcontrolcenter.controller.NuevoFiltroController">

    <padding><Insets bottom="20" left="20" right="20" top="16" /></padding>

    <Label maxWidth="Infinity" style="-fx-background-color: #2447c4; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10;" text="REGISTRAR NUEVO FILTRO / INSUMO" />

    <Label text="Código del Filtro" />
    <TextField fx:id="txtIdFiltro" promptText="Ej: FIL-AC-0013" />

    <Label text="Descripción" />
    <TextField fx:id="txtDescripcion" promptText="Descripción del filtro/insumo" />

    <HBox spacing="14">
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Categoría" />
            <ComboBox fx:id="cmbCategoria" maxWidth="Infinity" />
        </VBox>
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Unidad de Medida" />
         <TextField fx:id="txtUnidadMedida" />
        </VBox>
    </HBox>

    <HBox spacing="14">
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Stock Inicial" />
            <TextField fx:id="txtStockActual" promptText="0" />
        </VBox>
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Punto de Reorden" />
            <TextField fx:id="txtPuntoReorden" promptText="0" />
        </VBox>
    </HBox>

    <Label fx:id="lblError" style="-fx-text-fill: #d1453b;" />

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button fx:id="btnCancelar" onAction="#onCancelarClick" style="-fx-background-color: #b0b6c1; -fx-text-fill: white;" text="Cancelar" />
        <Button fx:id="btnGuardar" onAction="#onGuardarClick" style="-fx-background-color: #d1453b; -fx-text-fill: white; -fx-font-weight: bold;" text="Guardar" />
    </HBox>
</VBox>
