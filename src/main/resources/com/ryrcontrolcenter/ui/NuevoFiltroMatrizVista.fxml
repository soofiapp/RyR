<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="440.0" spacing="12" style="-fx-background-color: white;"
      xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ryrcontrolcenter.controller.NuevoFiltroMatrizController">

    <padding><Insets bottom="20" left="20" right="20" top="16" /></padding>

    <Label maxWidth="Infinity" style="-fx-background-color: #2447c4; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10;"
           text="ASOCIAR FILTRO A LA MÁQUINA" />

    <Label fx:id="lblMaquinaSeleccionada" style="-fx-font-weight: bold;" />

    <Label text="Sistema / Tipo de Filtro" />
    <TextField fx:id="txtSistemaTipoFiltro" promptText="Ej: Aceite de Motor" />

    <Label text="Código OEM Original" />
    <TextField fx:id="txtCodigoOem" promptText="Ej: CAT 1R-1808" />

    <Label text="Filtro en Stock (Kárdex)" />
    <ComboBox fx:id="cmbFiltroStock" maxWidth="Infinity" promptText="Seleccionar filtro del catálogo" />

    <Label fx:id="lblError" style="-fx-text-fill: #d1453b;" />

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button fx:id="btnCancelar" onAction="#onCancelarClick" style="-fx-background-color: #b0b6c1; -fx-text-fill: white;" text="Cancelar" />
        <Button fx:id="btnGuardar" onAction="#onGuardarClick" style="-fx-background-color: #d1453b; -fx-text-fill: white; -fx-font-weight: bold;" text="Guardar" />
    </HBox>
</VBox>
