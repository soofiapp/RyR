<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ButtonBar?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="mainPane" prefHeight="600.0" prefWidth="960.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ryrcontrolcenter.controller.MatrizFiltroController">

    <left>
        <VBox prefWidth="220" spacing="4" style="-fx-background-color: #2447c4;">
            <padding><Insets bottom="20" left="16" right="16" top="20" /></padding>
            <Label style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;" text="RyR Global" />
            <VBox spacing="2" style="-fx-padding: 20 0 0 0;">
                <Button maxWidth="Infinity" onAction="#irADashboard" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: baseline-left;" text="  Dashboard" />
                <Button maxWidth="Infinity" onAction="#irAPrestamos" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: baseline-left;" text="  Préstamos" />
                <Button maxWidth="Infinity" onAction="#irAInventariado" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: baseline-left;" text="  Inventariado" />
                <Button maxWidth="Infinity" style="-fx-background-color: #d1453b; -fx-text-fill: white; -fx-alignment: baseline-left;" text="  Matriz Filtro" />
                <Button maxWidth="Infinity" onAction="#irAKardex" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: baseline-left;" text="  Insumos / Kárdex" />
                <Button maxWidth="Infinity" onAction="#irAUsuariosBitacora" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: baseline-left;" text="  Usuarios y bitácora" />
            </VBox>
            <VBox VBox.vgrow="ALWAYS" />
            <Button maxWidth="Infinity" onAction="#onLogoutClick" style="-fx-background-color: white; -fx-text-fill: #2447c4;" text="Logout" />
        </VBox>
    </left>

    <center>
        <VBox spacing="14">
            <padding><Insets bottom="20" left="24" right="24" top="16" /></padding>

            <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Matriz de Compatibilidad: Máquina y Filtros OEM" />

            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label prefHeight="17.0" prefWidth="143.0" text="Seleccionar Maquinaria" />
                <ComboBox fx:id="cmbMaquina" prefHeight="25.0" prefWidth="229.0" />
                <VBox HBox.hgrow="ALWAYS" />
            <ButtonBar prefHeight="40.0" prefWidth="359.0">
               <buttons>
                  <Button fx:id="btnEliminarFiltro" minWidth="71.0" mnemonicParsing="false" onAction="#onEliminarFiltroClick" prefHeight="25.0" prefWidth="138.0" style="-fx-background-color: #d1453b; -fx-text-fill: white; -fx-font-weight: bold;" text="- Eliminar" />
                  <Button fx:id="btnModificarFiltro" minWidth="65.0" mnemonicParsing="false" prefHeight="25.0" style="-fx-background-color: #2196F3; -fx-font-weight: bold; -fx-text-fill: white;" text="⚙ Modificar" />
                      <Button fx:id="btnAgregarFiltro" onAction="#onAgregarFiltroClick" prefHeight="25.0" prefWidth="166.0" style="-fx-background-color: #2E7D32; -fx-text-fill: white; -fx-font-weight: bold;" text="+ Agregar" />
               </buttons>
            </ButtonBar>
            </HBox>

            <TableView fx:id="tablaMatriz" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colTipoFiltro" prefWidth="200" text="Tipo Filtro" />
                    <TableColumn fx:id="colCodigoOem" prefWidth="160" text="Código OEM" />
                    <TableColumn fx:id="colRefStock" prefWidth="200" text="Ref. En stock" />
                    <TableColumn fx:id="colAcciones" prefWidth="130.66668701171875" text="Acciones" />
                </columns>
            <columnResizePolicy>
               <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            </TableView>
        </VBox>
    </center>
</BorderPane>
