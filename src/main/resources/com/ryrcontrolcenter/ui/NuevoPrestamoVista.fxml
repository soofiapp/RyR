<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="480.0" spacing="12" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ryrcontrolcenter.controller.NuevoPrestamoController">

    <padding><Insets bottom="20" left="20" right="20" top="16" /></padding>

    <Label maxWidth="Infinity" style="-fx-background-color: #2447c4; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10;" text="REGISTRAR NUEVO PRÉSTAMO DE EQUIPO / KIT" />

    <Label text="Tipo de Ítem a Prestar" />
    <HBox spacing="10">
        <fx:define>
            <ToggleGroup fx:id="grupoTipoItem" />
        </fx:define>
        <RadioButton fx:id="rbMaquinaria" text="Maquinaria" toggleGroup="$grupoTipoItem" />
        <RadioButton fx:id="rbHerramientaUnica" selected="true" text="Herramienta Única" toggleGroup="$grupoTipoItem" />
        <RadioButton fx:id="rbKitCompleto" text="Kit Completo Configurado" toggleGroup="$grupoTipoItem" />
    </HBox>

    <Label text="Nombre del Operario / Cédula" />
    <TextField fx:id="txtOperario" promptText="Nombre - Cédula" />

    <Label text="Seleccionar Inventario Disponible" />
    <ComboBox fx:id="cmbActivoDisponible" maxWidth="Infinity" />

    <HBox spacing="14">
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Fecha Salida" />
            <DatePicker fx:id="dpFechaSalida" maxWidth="Infinity" />
        </VBox>
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Devolución Estimada" />
            <DatePicker fx:id="dpDevolucionEstimada" maxWidth="Infinity" />
        </VBox>
    </HBox>

    <Label text="Ubicación / Frente de Trabajo" />
    <TextField fx:id="txtUbicacion" />

    <Label text="Observaciones Iniciales" />
    <TextArea fx:id="txtObservaciones" prefRowCount="3" promptText="Inspección SST previa realizada sin novedades..." />

    <Label fx:id="lblError" style="-fx-text-fill: #d1453b;" />

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button fx:id="btnCancelar" onAction="#onCancelarClick" style="-fx-background-color: #b0b6c1; -fx-text-fill: white;" text="Cancelar" />
        <Button fx:id="btnAutorizarSalida" onAction="#onAutorizarSalidaClick" style="-fx-background-color: #d1453b; -fx-text-fill: white; -fx-font-weight: bold;" text="Autorizar Salida" />
    </HBox>
</VBox>