<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="mainPane" prefHeight="600.0" prefWidth="960.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ryrcontrolcenter.controller.PrestamosController">

    <!-- La barra lateral se repite igual que en Dashboard.fxml -->
    <left>
        <VBox prefWidth="220" spacing="4" style="-fx-background-color: #2447c4;">
            <padding><Insets bottom="20" left="16" right="16" top="20" /></padding>
            <Label style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;" text="RyR Global" />
            <VBox spacing="2" style="-fx-padding: 20 0 0 0;">
                <Button maxWidth="Infinity" onAction="#irADashboard" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: baseline-left;" text="  Dashboard" />
                <Button maxWidth="Infinity" style="-fx-background-color: #d1453b; -fx-text-fill: white; -fx-alignment: baseline-left;" text="  Préstamos" />
                <Button maxWidth="Infinity" onAction="#irAInventariado" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: baseline-left;" text="  Inventariado" />
                <Button maxWidth="Infinity" onAction="#irAMatrizFiltro" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: baseline-left;" text="  Matriz Filtro" />
                <Button maxWidth="Infinity" onAction="#irAKardex" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: baseline-left;" text="  Insumos / Kárdex" />
                <Button maxWidth="Infinity" onAction="#irAUsuariosBitacora" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: baseline-left;" text="  Usuarios y bitácora" />
            </VBox>
            <VBox VBox.vgrow="ALWAYS" />
            <Button maxWidth="Infinity" onAction="#onLogoutClick" style="-fx-background-color: white; -fx-text-fill: #2447c4;" text="Logout" />
        </VBox>
    </left>

    <center>
        <VBox spacing="14">
            <padding><Insets bottom="20" left="24" right="24" top="16" /></padding>
             <Label fx:id="lblTotalPrestamos" style="-fx-font-size: 15px; -fx-font-weight: bold;" text="Mostrando préstamos" />

            <HBox alignment="CENTER_LEFT">
                <ComboBox fx:id="cmbFiltro" prefHeight="25.0" prefWidth="89.0" promptText="Filtrar" />
                <TextField fx:id="txtBuscar" prefHeight="25.0" prefWidth="384.0" promptText="Busca por máquina, herramienta o código de prestación" HBox.hgrow="ALWAYS" />
                <VBox HBox.hgrow="ALWAYS" />
                <Button fx:id="btnAnadirPrestamo" onAction="#onAnadirPrestamoClick" prefHeight="25.0" prefWidth="160.0" style="-fx-background-color: #d1453b; -fx-text-fill: white; -fx-font-weight: bold;" text="+ Añadir préstamo" HBox.hgrow="ALWAYS" />
            </HBox>

            <TableView fx:id="tablaPrestamos" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colIdPrestamo" prefWidth="93.33335876464844" text="ID Préstamo" />
                    <TableColumn fx:id="colElemento" prefWidth="202.00003051757812" text="Elemento / Kit" />
                    <TableColumn fx:id="colOperario" prefWidth="107.33331298828125" text="Operario" />
                    <TableColumn fx:id="colSalida" prefWidth="104.66668701171875" text="Salida" />
                    <TableColumn fx:id="colEstado" prefWidth="120.6666259765625" text="Estado" />
                    <TableColumn fx:id="colAcciones" prefWidth="94.666748046875" text="Acciones" />
                </columns>
            <columnResizePolicy>
               <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            </TableView>
        </VBox>
    </center>
</BorderPane>
