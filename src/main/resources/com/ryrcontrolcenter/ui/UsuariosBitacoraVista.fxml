<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="mainPane" prefHeight="600.0" prefWidth="960.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ryrcontrolcenter.controller.UsuariosBitacoraController">

    <left>
        <VBox prefWidth="220" spacing="4" style="-fx-background-color: #2447c4;">
            <padding><Insets bottom="20" left="16" right="16" top="20" /></padding>
            <Label style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;" text="RyR Global" />
            <VBox spacing="2" style="-fx-padding: 20 0 0 0;">
                <Button maxWidth="Infinity" onAction="#irADashboard" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: baseline-left;" text="  Dashboard" />
                <Button maxWidth="Infinity" onAction="#irAPrestamos" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: baseline-left;" text="  Préstamos" />
                <Button maxWidth="Infinity" onAction="#irAInventariado" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: baseline-left;" text="  Inventariado" />
                <Button maxWidth="Infinity" onAction="#irAMatrizFiltro" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: baseline-left;" text="  Matriz Filtro" />
                <Button maxWidth="Infinity" onAction="#irAKardex" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-alignment: baseline-left;" text="  Insumos / Kárdex" />
                <Button maxWidth="Infinity" style="-fx-background-color: #d1453b; -fx-text-fill: white; -fx-alignment: baseline-left;" text="  Usuarios y bitácora" />
            </VBox>
            <VBox VBox.vgrow="ALWAYS" />
            <Button maxWidth="Infinity" onAction="#onLogoutClick" style="-fx-background-color: white; -fx-text-fill: #2447c4;" text="Logout" />
        </VBox>
    </left>

    <center>
        <VBox spacing="20">
            <padding><Insets bottom="20" left="24" right="24" top="16" /></padding>

            <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Control de Usuarios y Bitácora Auditora" />
         <VBox maxHeight="-Infinity" maxWidth="1.7976931348623157E308" VBox.vgrow="ALWAYS">
            <children>
               <HBox alignment="CENTER_LEFT" VBox.vgrow="ALWAYS">
                  <children>
                         <Label prefHeight="17.0" prefWidth="133.0" style="-fx-font-weight: bold;" text="Usuarios del sistema" HBox.hgrow="ALWAYS" />
                     <VBox HBox.hgrow="ALWAYS" />
                     <Button fx:id="btnRegistrarUsuario" mnemonicParsing="false" onAction="#onRegistrarUsuarioClick" prefHeight="25.0" prefWidth="126.0" style="-fx-background-color: #d1453b; -fx-text-fill: white; -fx-font-weight: bold;" text="+ Registrar usuario" HBox.hgrow="ALWAYS" />
                  </children>
               </HBox>
            </children>
         </VBox>
         <VBox prefHeight="261.0" prefWidth="692.0">
            <children>
                   <TableView fx:id="tablaUsuarios" prefHeight="260.0" prefWidth="692.0">
                       <columns>
                           <TableColumn fx:id="colUsuario" prefWidth="150" text="Usuario" />
                           <TableColumn fx:id="colRol" prefWidth="130" text="Rol" />
                           <TableColumn fx:id="colFrentePlanta" prefWidth="220" text="Frente / Planta" />
                           <TableColumn fx:id="colUltimoAcceso" prefWidth="160" text="Último acceso" />
                       </columns>
                  <columnResizePolicy>
                     <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                  </columnResizePolicy>
                   </TableView>
            </children>
         </VBox>
             <Label style="-fx-font-weight: bold;" text="Bitácora de Eventos y Cambios" />
             <TableView fx:id="tablaBitacora" VBox.vgrow="ALWAYS">
                 <columns>
                     <TableColumn fx:id="colFechaHora" prefWidth="150" text="Fecha / Hora" />
                     <TableColumn fx:id="colUsuarioBitacora" prefWidth="130" text="Usuario" />
                     <TableColumn fx:id="colAccion" prefWidth="260" text="Acción realizada" />
                     <TableColumn fx:id="colModulo" prefWidth="140" text="Módulo afectado" />
                 </columns>
            <columnResizePolicy>
               <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
             </TableView>
        </VBox>
    </center>
</BorderPane>
