<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="420.0" spacing="12" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ryrcontrolcenter.controller.NuevoMovimientoController">

    <padding><Insets bottom="20" left="20" right="20" top="16" /></padding>

    <fx:define>
        <ToggleGroup fx:id="grupoTipoMovimiento" />
    </fx:define>

    <Label maxWidth="Infinity" style="-fx-background-color: #2447c4; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10;" text="REGISTRAR MOVIMIENTO DE KÁRDEX" />

    <Label text="Tipo de movimiento" />
    <HBox spacing="14">
        <RadioButton fx:id="rbEntrada" text="Entrada" toggleGroup="$grupoTipoMovimiento" />
        <RadioButton fx:id="rbSalida" selected="true" text="Salida" toggleGroup="$grupoTipoMovimiento" />
        <RadioButton fx:id="rbAjuste" text="Ajuste (conteo físico)" toggleGroup="$grupoTipoMovimiento" />
    </HBox>

    <Label text="Filtro / Insumo" />
    <ComboBox fx:id="cmbFiltro" maxWidth="Infinity" promptText="Seleccionar elemento" />

    <Label fx:id="lblStockActual" style="-fx-font-weight: bold;" text="Stock actual: -" />

    <Label fx:id="lblCantidad" text="Cantidad a sacar" />
    <TextField fx:id="txtCantidad" promptText="Cantidad" />

    <Label fx:id="lblSaldoResultante" style="-fx-text-fill: #6b7280;" text=" " />
    <Label fx:id="lblError" style="-fx-text-fill: #d1453b;" wrapText="true" />

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button fx:id="btnCancelar" onAction="#onCancelarClick" style="-fx-background-color: #b0b6c1; -fx-text-fill: white;" text="Cancelar" />
        <Button fx:id="btnGuardar" defaultButton="true" onAction="#onGuardarClick" style="-fx-background-color: #d1453b; -fx-text-fill: white; -fx-font-weight: bold;" text="Guardar" />
    </HBox>
</VBox>
