<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="460.0" spacing="12" style="-fx-background-color: white;"
      xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ryrcontrolcenter.controller.NuevoInventarioController">

    <padding><Insets bottom="20" left="20" right="20" top="16" /></padding>

    <Label style="-fx-background-color: #2447c4; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10;"
           maxWidth="Infinity" text="AGREGAR AL INVENTARIO" />

    <Label text="Código QR / ID" />
    <TextField fx:id="txtIdActivo" promptText="Ej: HERR-0103" />

    <Label text="Descripción del Activo" />
    <TextField fx:id="txtDescripcion" promptText="Descripción" />

    <HBox spacing="14">
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Tipo de Activo" />
            <ComboBox fx:id="cmbTipoActivo" maxWidth="Infinity" />
        </VBox>
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Estado SST" />
            <ComboBox fx:id="cmbEstadoSst" maxWidth="Infinity" />
        </VBox>
    </HBox>

    <HBox spacing="14">
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Ubicación" />
            <ComboBox fx:id="cmbUbicacion" maxWidth="Infinity" />
        </VBox>
        <VBox spacing="6" HBox.hgrow="ALWAYS">
            <Label text="Fecha de Registro" />
            <DatePicker fx:id="dpFechaRegistro" maxWidth="Infinity" />
        </VBox>
    </HBox>

    <Label text="Observaciones" />
    <TextArea fx:id="txtObservaciones" prefRowCount="3" promptText="Observaciones iniciales..." />

    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button fx:id="btnCancelar" onAction="#onCancelarClick" style="-fx-background-color: #b0b6c1; -fx-text-fill: white;" text="Cancelar" />
        <Button fx:id="btnGuardar" onAction="#onGuardarClick"
                style="-fx-background-color: #d1453b; -fx-text-fill: white; -fx-font-weight: bold;" text="Guardar" />
    </HBox>
</VBox>
